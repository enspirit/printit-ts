{
  "name": "@enspirit/printit",
  "version": "2.1.0",
  "description": "Printit",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "build:watch": "tsc -w",
    "test": "mocha tests/helpers.ts 'tests/**/*.spec.ts'",
    "test:watch": "mocha tests/helpers.ts 'tests/**/*.spec.ts' --watch --watch-files src/**/*.ts,tests/**/*.ts",
    "lint": "eslint src tests",
    "preversion": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/src/index.js",
    "dev": "tsc-watch --onSuccess 'node ./dist/src/index.js'"
  },
  "keywords": [],
  "author": "@enspirit srl",
  "license": "MIT",
  "files": [
    "dist/src",
    "dist/package.json"
  ],
  "exports": {
    ".": "./dist/src/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "html-to-docx": "^1.8.0",
    "js-yaml": "^4.3.2",
    "sanitize-html": "^2.18.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/sinon": "^22.0.1",
    "@types/sinon-chai": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "supertest": "^7.3.1",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=24.0.0"
  }
}
